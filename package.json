{
  "name": "eft_tasktrack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://ptozax.github.io/EFT_TaskTrack/",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/ensure-data.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "prebuild": "node scripts/ensure-data.mjs",
    "build": "vite build",
    "ensure-data": "node scripts/ensure-data.mjs",
    "update-optimizer": "node scripts/update-optimizer-data.mjs",
    "update-items": "node scripts/update-items.mjs",
    "update-price": "node scripts/update-price-data.mjs",
    "update-gear": "node scripts/update-gear-data.mjs",
    "update-data": "node scripts/update-data.mjs",
    "update-loot": "node scripts/update-loot.mjs",
    "update-story": "node scripts/update-story.mjs",
    "update-maps": "node scripts/update-maps.mjs",
    "update": "npm run update-items && npm run update-price && npm run update-gear && npm run update-optimizer && npm run update-loot",
    "update-all": "npm run update && npm run update-data && npm run update-story && npm run update-maps",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.5",
    "bootstrap": "^5.3.3",
    "d3": "^7.9.0",
    "dagre": "^0.8.5",
    "framer-motion": "^12.6.2",
    "html2canvas": "^1.4.1",
    "react": "^19.0.0",
    "react-bootstrap": "^2.10.9",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.3.0",
    "tailwindcss": "^4.1.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "vite": "^6.2.0"
  }
}
